<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Happy Boyfriend's Day ❤️</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Trebuchet MS',sans-serif;
}

body{

background:#3d0715;
overflow:hidden;

}

/* ---------- Floating Hearts ---------- */

.heart{

position:absolute;

font-size:20px;

opacity:.35;

animation:float 14s linear infinite;

}

@keyframes float{

0%{

transform:translateY(120vh);

}

100%{

transform:translateY(-120vh);

}

}

/* ---------- Intro ---------- */

#intro{

position:fixed;

top:0;
left:0;

width:100%;
height:100%;

display:flex;

justify-content:center;

align-items:center;

background:linear-gradient(160deg,#3d0715,#6b0f1a);

}

.card{

width:92%;

max-width:380px;

background:#fffaf3;

border-radius:28px;

padding:35px;

text-align:center;

box-shadow:0 20px 40px rgba(0,0,0,.35);

animation:appear .8s;

}

.card h1{

color:#8b0000;

font-size:34px;

margin-bottom:18px;

}

.card p{

color:#5b3a29;

font-size:17px;

line-height:1.8;

margin-bottom:28px;

}

button{

padding:14px 32px;

border:none;

border-radius:50px;

background:#8b0000;

color:white;

font-size:17px;

cursor:pointer;

transition:.3s;

}

button:hover{

transform:scale(1.06);

}

@keyframes appear{

from{

opacity:0;

transform:translateY(40px);

}

to{

opacity:1;

transform:translateY(0);

}

}

</style>

</head>

<body>

<div class="kiss">💋</div>
<div class="kiss" style="left:12%;top:15%;transform:rotate(-20deg);">💋</div>
<div class="kiss" style="left:75%;top:10%;transform:rotate(25deg);">💋</div>
<div class="kiss" style="left:20%;bottom:10%;transform:rotate(10deg);">💋</div>
<div class="kiss" style="right:10%;bottom:15%;transform:rotate(-15deg);">💋</div>

<div class="sparkle">✨</div>
<div class="sparkle" style="left:20%;top:8%;">✨</div>
<div class="sparkle" style="right:18%;bottom:20%;">✨</div>

<div id="intro">

<div class="card">

<h1>Hieeeee Babyyyy ❤️</h1>

<p class="subtitle">

Before you continue...

I have a tiny request 🥹

</p>

<div class="chat">

<div class="myMsg">

Hieeeee Babyyyy ❤️

</div>

<div id="replyBox">

<input
id="reply"
type="text"
placeholder="Type your reply here..."
>

<button id="sendBtn">

Send ❤️

</button>

</div>

<div id="messages"></div>

</div>

</div>

</div>

<script>

const send=document.getElementById("sendBtn");

send.onclick=function(){

let text=document.getElementById("reply").value.trim();

if(text==""){

alert("At least say Helloooo ❤️");

return;

}

document.getElementById("replyBox").style.display="none";

document.getElementById("messages").innerHTML=`

<div class="hisMsg">

${text}

</div>

<div class="myMsg">

Happy Boyfriend's Dayyyyy ❤️🥹

</div>

<div class="myMsg">

I made something just for you...

</div>

<div class="myMsg">

Preparing your surprise... ✨

</div>

<br>

<button id="continue">

Continue ❤️

</button>

`;

}

</script>

</body>
clearInterval(loadin

</html>